FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY digital_backend/ ./digital_backend/

RUN mkdir -p digital_backend/logs

EXPOSE 8080

CMD ["uvicorn", "digital_backend.main:app", "--host", "0.0.0.0", "--port", "8080"]
